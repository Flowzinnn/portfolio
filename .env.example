# Copie este arquivo para .env e preencha. O .env NUNCA vai para o GitHub.

# Senha do painel /admin (use uma senha longa, só sua)
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Opcional: webhook chamado a cada novo contato (ex.: um fluxo do n8n que te avisa no WhatsApp/Telegram)
LEAD_WEBHOOK_URL=

# Opcional: token do túnel da Cloudflare (Zero Trust → Networks → Tunnels → Create tunnel)
CLOUDFLARE_TUNNEL_TOKEN=
